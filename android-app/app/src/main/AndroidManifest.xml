<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Used later for the "look at what's on screen" MediaProjection flow -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      Package visibility (Android 11+ / targetSdk 30+). Without these, the speech
      recognizer and TTS engines live in other packages we can't see, so
      SpeechRecognizer.isRecognitionAvailable() returns false and TextToSpeech
      fails to bind to an engine. Required for the voice pipeline to work at all.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AgenticOS"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AgenticOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
